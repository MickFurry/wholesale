# Copy to .env and fill in values.
WHOLESALE_CONFIG_PATH=./config.yaml

# Outbound sending (optional). If unset, system runs in dry-run mode.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_user
# SMTP_PASS=your_pass
# SMTP_FROM="Your Name <you@example.com>"

# Twilio (optional)
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1...

# Safety/Compliance
# Default behavior is DRY-RUN, and outreach will not send unless explicitly enabled in config.yaml.
